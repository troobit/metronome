{
  // Markdownlint configuration
  "config": {
    "default": true,
    "MD013": false, // Line length - allow long lines for links and tables
    "MD033": false, // Allow inline HTML for complex formatting
    "MD041": false, // Allow first line not to be a top-level heading
  },
  "globs": ["**/*.md"],
  "ignores": ["node_modules", "dist"],
}
